{#
/**
 * @file
 * SQU Search: input on the left, icon fixed on the right of the field.
 */
#}
<div{{ attributes.addClass('squ-header-search-block', 'squ-header-search-block--squ-search') }}>
  {{ title_prefix }}
  {{ title_suffix }}
  <div class="search-wrap">
    <div class="search-panel" id="squ-search-panel" hidden>
      {{ content }}
    </div>

    <button class="icon-btn" id="squ-search-toggle" type="button" aria-expanded="false" aria-controls="squ-search-panel" aria-label="{{ 'Search'|t }}">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="6.25" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
        <path d="M16 16.5 L20 20.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</div>
