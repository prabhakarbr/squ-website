{#
/**
 * @file
 * Page shell (top to bottom):
 *   1. Header — branding, navigation tools, section menu
 *   2. Breadcrumb
 *   3. Main — optional sidebar (left) + content
 *   4. Footer
 *
 * @see squ_theme.info.yml
 */
#}
{% set sidebar_markup = page.sidebar_first|render %}
{% set breadcrumb_markup = page.breadcrumb|render %}
{% set squ_landing_layout = is_front or (node is defined and node.bundle == 'home_page') %}
{% set squ_use_left_sidebar = not squ_landing_layout %}
{% set has_left_sidebar = squ_use_left_sidebar and sidebar_markup|striptags|trim is not empty %}
{% set has_breadcrumb = breadcrumb_markup|striptags|trim is not empty %}
<div class="squ-page layout-container{{ has_left_sidebar ? ' squ-page--with-sidebar' : '' }}{{ has_breadcrumb ? ' squ-page--has-breadcrumb' : '' }}{{ squ_landing_layout ? ' squ-page--landing' : '' }}">

  {# —— 1. Header: logo, tools, section menu —— #}
  <header class="site-header squ-site-header{{ page.header_section ? ' squ-site-header--section' : '' }}" data-squ-header>
    <div class="header-inner">
      <div class="squ-region squ-region--header-brand">
        {{ page.header_brand }}
      </div>
      <div class="squ-region squ-region--header-tools">
        <div class="header-tools">
            <div class="search-wrap">
              <div class="search-panel" id="squ-search-panel" hidden>
                <form id="squ-search-form" role="search" method="get" data-squ-search-form>
                  <input id="squ-search-input" type="search" name="keys" placeholder="{{ 'Search'|t }}" aria-label="{{ 'Search'|t }}" data-i18n-placeholder="searchPlaceholder">
                </form>
              </div>
              <button class="icon-btn" id="squ-search-toggle" type="button" aria-expanded="false" aria-controls="squ-search-panel" aria-label="{{ 'Search'|t }}">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="11" cy="11" r="6.25" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
                  <path d="M16 16.5 L20 20.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                </svg>
              </button>
            </div>
            {{ page.header_tools }}
            {{ page.header_lang }}
            <button class="icon-btn" id="squ-menu-toggle" type="button" aria-expanded="false" aria-controls="squ-drawer" aria-label="{{ 'Open menu'|t }}">
              <span class="burger" aria-hidden="true"><span></span><span></span><span></span></span>
            </button>
        </div>
      </div>
    </div>
    {% if page.header_section %}
      <div class="primary-bar squ-region squ-region--header-section">
        <div class="container-fluid px-3 px-lg-4">
          {{ page.header_section }}
        </div>
      </div>
    {% endif %}
  </header>

  <div class="squ-menu-shell">
    <aside class="squ-drawer" id="squ-drawer" aria-hidden="true" aria-label="{{ 'Menu'|t }}" inert>
      <div class="drawer-head">
        <button class="drawer-close" id="squ-drawer-close" type="button" aria-label="{{ 'Close menu'|t }}">&times;</button>
      </div>
      <nav class="squ-drawer__nav squ-drawer__nav--hamburger squ-region squ-region--header-drawer" aria-label="{{ 'Menu'|t }}">
        {{ page.header_drawer }}
      </nav>
    </aside>
  </div>

  {# —— 2. Breadcrumb (Block layout region) —— #}
  {% if has_breadcrumb and not squ_landing_layout %}
    <div class="squ-page__breadcrumb-wrap">
      <div class="squ-page__breadcrumb squ-region squ-region--breadcrumb container-fluid px-3 px-lg-4">
        {{ breadcrumb_markup }}
      </div>
    </div>
  {% endif %}

  {% if page.highlighted %}
    <div class="squ-region squ-region--highlighted">
      {{ page.highlighted }}
    </div>
  {% endif %}

  {# —— 3. Main: landing (full bleed) or sidebar + content —— #}
  <main class="squ-page__main{{ squ_landing_layout ? ' squ-page__main--landing' : '' }}" role="main">
    <a id="main-content" tabindex="-1"></a>
    {% if squ_landing_layout %}
      <div class="squ-page__body squ-page__body--landing">
        <div class="squ-page__content squ-region squ-region--content">
          {{ page.content }}
          {{ page.help }}
        </div>
      </div>
    {% else %}
      <div class="squ-page__body container-fluid px-3 px-lg-4">
        <div class="row g-4 squ-page__row">
          {% if has_left_sidebar %}
            <aside class="col-12 col-lg-3 order-lg-1 squ-left-sidebar squ-region squ-region--sidebar-first" role="complementary" aria-label="{{ 'Sidebar'|t }}">
              {{ sidebar_markup }}
            </aside>
            <div class="col-12 col-lg-9 order-lg-2 squ-page__content squ-region squ-region--content">
              {{ page.content }}
              {{ page.help }}
            </div>
          {% else %}
            <div class="col-12 squ-page__content squ-region squ-region--content">
              {{ page.content }}
              {{ page.help }}
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </main>

  {# —— 4. Footer —— #}
  <footer class="squ-footer squ-chrome-footer">
    <div class="squ-footer__pattern" aria-hidden="true"></div>
    {% if page.footer_top %}
      <div class="squ-footer__main">
        <div class="squ-footer__inner squ-region squ-region--footer-top">
          {{ page.footer_top }}
        </div>
      </div>
    {% endif %}
    {% if page.footer_bottom %}
      <div class="squ-footer__bar">
        <div class="squ-footer__bar-inner squ-region squ-region--footer-bottom">
          {{ page.footer_bottom }}
        </div>
      </div>
    {% endif %}
  </footer>
</div>
