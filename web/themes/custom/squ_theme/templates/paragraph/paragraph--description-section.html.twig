{% block paragraph %}
  <div{{ attributes.addClass('description-section') }}>
    {% block content %}

      {% if content.field_description_content|render|striptags|trim is not empty %}
          <div class="banner-slider__divider" aria-hidden="true">
            <span class="banner-slider__line"></span>

            <span class="banner-slider__icon">
              <svg viewBox="0 0 24 24"
                   width="22"
                   height="22"
                   fill="none"
                   xmlns="http://www.w3.org/2000/svg">
                <path d="M12 3L20 12L12 21L4 12L12 3Z"
                      stroke="currentColor"
                      stroke-width="1.5"/>
                <path d="M8 12L12 8L16 12L12 16L8 12Z"
                      stroke="currentColor"
                      stroke-width="1.5"/>
              </svg>
            </span>

            <span class="banner-slider__line"></span>
          </div>

        <div class="description-section__content">
          {{ content.field_description_content }}
        </div>
      {% endif %}

    {% endblock %}
  </div>
{% endblock paragraph %} 