{#
  research_card — home research section or squ_libraries cards.
#}

{% set url = paragraph.field_research_card_link.0.url %}
{% set has_caption = paragraph.field_research_card_title.value or paragraph.field_research_card_description.value %}

<{{ url ? 'a' : 'div' }} class="squ-research__card{{ has_caption ? '' : ' squ-research__card--cover' }}"{% if url %} href="{{ url }}"{% endif %}>
  <div class="squ-research__card-media">{{ content.field_research_image }}</div>

  {% if has_caption %}
    <div class="squ-research__card-body">
      {% if content.field_research_card_title %}
        <h3 class="squ-research__card-heading">{{ content.field_research_card_title }}</h3>
      {% endif %}

      {% if content.field_research_card_description %}
        <div class="squ-research__card-desc">{{ content.field_research_card_description }}</div>
      {% endif %}
    </div>
  {% endif %}
</{{ url ? 'a' : 'div' }}>
