<div class="single-news-slider__viewport">
  <div class="single-news-slider__track">

    {% for item in paragraph.field_slide_items %}
      {% set slide = item.entity %}

      {% if slide %}
        <div class="single-news-slider__slide">

          {% if slide.field_single_slide_imgae.entity %}
            {% set image = slide.field_single_slide_imgae.entity %}

            {% if slide.field_link.0.url %}
              <a href="{{ slide.field_link.0.url }}">
            {% endif %}

            <img
              src="{{ file_url(image.uri.value) }}"
              alt="{{ slide.field_single_slide_imgae.0.alt|default('News image') }}"
              class="single-news-slider__image"
              loading="lazy"
            >

            {% if slide.field_link.0.url %}
              </a>
            {% endif %}
          {% endif %}

        </div>
      {% endif %}
    {% endfor %}

  </div>
</div>