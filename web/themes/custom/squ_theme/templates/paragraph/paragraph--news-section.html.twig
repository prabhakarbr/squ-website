{#
  Bundle: news_section
  Parent fields:
    - field_news_heading        (Short text)
    - field_news_items          (Entity reference revisions -> news_item)
    - field_news_section_image  (Image)
    - field_more_link           (Link)

  Child (news_item) fields:
    - field_news_title        (Short text)
    - field_news_date         (Datetime)
    - field_news_description  (Long text)
#}
{% set heading    = paragraph.field_news_heading.value %}
{% set img_file   = paragraph.field_news_section_image.entity %}
{% set more_url   = paragraph.field_more_link.0.url %}
{% set more_title = paragraph.field_more_link.0.title %}

<section class="squ-news">
  <div class="squ-news__inner">
    <div class="squ-news__grid">

      {# LEFT #}
      <div class="squ-news__list">

        {% if heading %}
          <h2 class="squ-news__heading">
            <span class="squ-news__icon" aria-hidden="true"></span>
            {{ heading }}
          </h2>
        {% endif %}

        {% for item in paragraph.field_news_items %}
          {% set news = item.entity %}
          {% if news and news.status.value %}
            {% set n_title = news.field_news_title.value %}
            {% set n_date  = news.field_news_date.date %}
            {% set n_desc  = news.field_news_description.value %}

            <article class="squ-news__item">
              {% if n_title %}
                <h3 class="squ-news__item-title">{{ n_title }}</h3>
              {% endif %}

              {% if n_desc %}
                <div class="squ-news__item-desc">{{ n_desc|raw }}</div>
              {% endif %}
                {% if n_date %}
                <div class="squ-news__item-date">{{ n_date|date('d F Y') }}</div>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}

        {% if more_url %}
          <div class="squ-news__more">
            <a href="{{ more_url }}" class="squ-news__more-btn">{{ more_title ?: 'Read More' }}</a>
          </div>
        {% endif %}

      </div>

      {# RIGHT #}
      {% if img_file %}
        <div class="squ-news__media">
          <div class="squ-news__frame"></div>
          <img class="squ-news__img"
               src="{{ file_url(img_file.uri.value) }}"
               alt="{{ paragraph.field_news_section_image.alt ?: heading }}"
               loading="lazy">
        </div>
      {% endif %}

    </div>
  </div>
</section>